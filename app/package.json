{
  "name": "activelyskin-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:backup": "tsx src/db/backup.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "fetch:youtube-videos": "tsx src/db/fetch-youtube-videos.ts",
    "enrich:pubchem": "tsx src/db/enrich-pubchem.ts",
    "enrich:ewg": "tsx src/db/enrich-ewg.ts",
    "recalls:backfill": "tsx src/db/backfill-recalls.ts",
    "prices:backfill": "tsx src/db/backfill-prices.ts",
    "images:sync": "tsx src/db/sync-images.ts",
    "test": "tsx --test src/db/*.test.ts src/lib/*.test.ts src/lib/prices/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "csv-parse": "^7.0.3",
